import calendar

#Task - ABC Engineering College is preparing the academic calendar for 2027. The principal wants to print the complete calendar of the year.nd print whether it is a leap year.

print(calendar.calendar(2027))
if calendar.isleap(2027):
    print("2027 is a leap year")
else:
    print("2027 is not a leap year")

