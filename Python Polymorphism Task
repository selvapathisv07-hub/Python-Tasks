#Task - A geometry app should call the same area() operation on circles, rectangles, and triangles and let each shape compute its own result.

class Circle:

    def area(self,radius):
        print(f"The area of the circle of radius {radius} is {(22/7)*(radius**2)}m²")

class Rectangle:

    def area(self,l,b):
        print(f"The area of the rectangle of length {l} and width {b} is {l*b}m²")

class Triangle:

    def area(self,height,base):
        print(f"The area of the triangle of height {height} and base {base} is {(1/2)*base*height}m²")

ci=Circle()
re=Rectangle()
tri=Triangle()
ci.area(8)
re.area(5,6)
tri.area(4,6)

