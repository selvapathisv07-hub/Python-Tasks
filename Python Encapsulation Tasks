#Task - A student portal must prevent marks from being modified directly and allow updates only through validation methods.

class Student:

    def __init__(self,i,name,mark):
        self.i=i
        self.name=name
        self.__mark=mark

    def get_marks(self):
        print(f"Studend ID: {self.i}")
        print(f"Name: {self.name}")
        print(f"Mark: {self.__mark}")

    def update_mark(self,m):
        if 0<=m<=100:
            self.__mark=m
            print("Mark has been updated successfully")
        else:
            print("Invaid mark")

