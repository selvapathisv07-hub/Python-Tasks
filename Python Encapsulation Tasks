s1.get_marks()

#Task - A banking application must hide the balance field and expose only deposit, withdraw, and balance-check operations.

class Account:

    def __init__(self,Acc_num,name,bal):
        self.Acc_num=Acc_num
        self.name=name
        self.__bal=bal

    def deposit(self,amount):
        self.__bal+=amount
        print(f"Account Number: {self.Acc_num}")
        print(f"Name: {self.name}")
        print("Amount has been deposited successfully")

    def withdraw(self,amount):
        if amount<=self.__bal:
            self.__bal-=amount
            print(f"Account Number: {self.Acc_num}")
            print(f"Name: {self.name}")
            print("Amount has been withdrawn successfully")

    def show_bal(self):
        print(f"Current Balance: {self.__bal}")

a1=Account(456789087,"Selva",78000)
a1.deposit(56000)
a1.withdraw(7000)
a1.show_bal()
#a1.bal

#Task - An employee payroll system must keep salary private and permit changes only through authorized methods.

class Employee:

    def __init__(self,name,age,sal):
