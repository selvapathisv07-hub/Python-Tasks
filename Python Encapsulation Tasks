#Task -  A mobile inventory app must prevent direct edits to product price and enforce updates through pricing rules.

class Product:

    def __init__(self,name,brand,stock,price):
        self.name=name
        self.brand=brand
        self.stock=stock
        self.__price=price

    def buy(self,quantity):
        self.stock-=quantity
        print(f"Product Name: {self.name}")
        print(f"Brand: {self.brand}")
        print(f"Price: {self.__price}")

    def update_price(self,new):
        self.__price=new
        print("Price has been updated successfully")

    def show_price(self):
        print(f"Price : {self.__price}")

p1=Product("IQOO Z10X","IQOO",20,30000)
p1.buy(1)
p1.show_price()
p1.update_price(28000)
p1.show_price()
p1.__price=50000
p1.show_price()

#Task - A car showroom must expose price information through accessor methods while preventing arbitrary direct modification.

class Car:

    def __init__(self,brand,model,price):
        self.brand=brand
        self.model=model
        self.__price=price

    def update_car_price(self,new_price):
        self.__price=new_price
        print("Car price has been updated successfully")

    def show_car_price(self):
        print(f"Price: Rs.{self.__price}")

    def details(self):
        print(f"Car brand: {self.brand}")
        print(f"Model: {self.model}")
        print(f"Price: Rs.{self.__price}")

c1=Car("BMW","M4 Competition",15000000)
c1.update_car_price(16000000)
c1.show_car_price()
c1.details()
c1.__price=15500000
c1.show_car_price()

