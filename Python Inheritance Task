#Task -  A drawing tool defines common shape properties and lets circles and rectangles calculate their own areas.

class Shape:

    def __init__(self,name,color):
        self.name=name
        self.color=color

    def area():
        pass

class Circle(Shape):

    def __init__(self, name, color,radius):
        super().__init__(name, color)
        self.radius=radius

    def area(self):
        print(f"The area of the circle of radius {self.radius} is {(22/7)*(self.radius)**2}")

class Rectangle(Shape):

    def __init__(self, name, color,length,width):
        super().__init__(name, color)
        self.length=length
        self.width=width

    def area(self):
        print(f"The area of the rectangle of length {self.length} and width {self.width} is {self.length*self.width}")

circle=Circle("Circle","Red",7)
rectangle=Rectangle("Rectangle","Purple",7,6)

circle.area()
rectangle.area()

#Task - A banking system defines generic account operations while savings accounts add interest calculation and current accounts add overdraft handling.

class Account:

    def __init__(self,Acc_num,name,balance):
        self.Acc_num=Acc_num
        self.name=name
        self.balance=balance

    def deposit(self,amount):
        self.balance+=amount
        print("-"*50)
        print("ACCOUNT".center(50," "))
        print("-"*50)
        print(f"Account Number: {self.Acc_num}")
        print(f"Name: {self.name}")
        print("The money has been deposited successfully")
        print(f"Current Balance: ${self.balance}")
        print("-"*50)
        print("\n")

    def withdraw(self,amount):
        if amount<=0:
            return False
        
        if amount<=self.balance:
            self.balance-=amount
            print("-"*50)
            print("ACCOUNT".center(50," "))
            print("-"*50)
            print(f"Account Number: {self.Acc_num}")
            print(f"Name: {self.name}")
            print("The money has been withdrawn successfully")
            print(f"Current Balance: ${self.balance}")
            print("-"*50)
            print("\n")

    def monthly():
        pass

class Savings_Account(Account):

    def __init__(self, Acc_num, name, balance,interest):
        super().__init__(Acc_num, name, balance)
        self.interest=interest

    def monthly(self):
        self.balance=self.balance+self.balance*(self.interest/100)
        print("-"*50)
        print("ACCOUNT".center(50," "))
        print("-"*50)
        print(f"Account Number: {self.Acc_num}")
        print(f"Name: {self.name}")
        print(f"Current Balance: ${self.balance}")
        print("-"*50)
        print("\n")

class Current_Account(Account):

    def __init__(self, Acc_num, name, balance,overdraft_limit):
        super().__init__(Acc_num, name, balance)
        self.overdraft_limit=overdraft_limit

    def withdraw(self, amount):
        if amount<=0:
            return False

        if (self.balance-amount)>=-self.overdraft_limit:
            self.balance-=amount
            status="Overdraft Used" if self.balance<0 else "Approved"
            print("-"*50)
            print("ACCOUNT".center(50," "))
            print("-"*50)
            print(f"Account Number: {self.Acc_num}")
            print(f"Name: {self.name}")
            print(f"Withdrawl amount : ${amount} - {status}")
            print(f"Current Balance: ${self.balance}")
            print("-"*50)
            print("\n")
        else:
            
            print(f"Attempting ${amount} Withdrawal: Transaction Denied (Exceeds Overdraft Limit of ${self.overdraft_limit})")

