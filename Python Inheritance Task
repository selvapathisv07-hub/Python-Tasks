#Task - A product catalog stores generic product details and extends electronics with warranty information and clothing with size information.

class Product:

    def __init__(self,name,brand,category,stock,price):
        self.name=name
        self.category=category
        self.stock=stock
        self.price=price
        self.brand=brand

    def show(self):
        pass

class Electronics(Product):

    def __init__(self, name,brand,category, stock, price,warranty):
        super().__init__(name,brand,category, stock, price)
        self.warranty=warranty

    def show(self):
        print("-"*50)
        print("PRODUCT DETAILS".center(50," "))
        print("-"*50)
        print(f"Category: {self.category}")
        print(f"Item name: {self.name}")
        print(f"Stock Available: {self.stock}")
        print(f"Price : ${self.price}")
        print(f"Warranty: {self.warranty} years")
        print("-"*50)
        print("\n")

class Cloth(Product):

    def __init__(self, name,brand,category, stock, price,size):
        super().__init__(name,brand,category, stock, price)
        self.size=size

    def show(self):
        print("-"*50)
        print("PRODUCT DETAILS".center(50," "))
        print("-"*50)
        print(f"Category: {self.category}")
        print(f"Item name: {self.name}")
        print(f"Stock Available: {self.stock}")
        print(f"Price : ${self.price}")
        print(f"Size: {self.size} ")
        print("-"*50)
        print("\n")

