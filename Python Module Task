#Task - A calculator application requires addition, subtraction, multiplication, and division operations. Create these functions in a user-defined module and import the module into the main program to perform the calculations.

def add(*n):
    c=0
    for i in n:
        c+=i
        print(f"The sum of the numbers is {c}")

def sub(a,b):
    c=a-b
    print(f"The difference of the numbers is {c}")

def mul(*n):
    c=1
    for i in n:
        c*=i
        print(f"The product of the numbers is {c}")

def div(a,b):
    try:
        if b!=0:
            c=a/b
            print(f"The divided value is {c}")
        else:
            raise ZeroDivisionError("The number cannot be divided by zero")
    except ZeroDivisionError as e:
        print("Error :",e)

#Task - A library management system wants to store functions for issuing books, returning books, and checking book availability in a separate module. The main program should import the module and execute the required library operation.

library_inventory = {"1984": 3,"To Kill a Mockingbird": 0,"The Great Gatsby": 2,"Dune": 5}


def check_availability(book_title):
    copies = library_inventory.get(book_title,0)
    if copies>0:
        print(f"The book '{book_title}' is available")
    else:
        print(f"Sorry, the book '{book_title}' is not available")

def issue_book(book_title):
    if library_inventory.get(book_title, 0)>0:
        library_inventory[book_title]-= 1
        print(f"Successfully issued '{book_title}'. Enjoy reading!")
    else:
        print(f"Cannot issue '{book_title}'. It is either out of stock or not in the system.")

def return_book(book_title):
    if book_title in library_inventory:
        library_inventory[book_title] += 1
    else:
        library_inventory[book_title] = 1

