#Task - A workshop tool needs to compute the area and circumference of circular plates from user-provided radii.

class circle:
    def __init__(self,r):
        self.r=r

    def carea(self):
        print(f"The area of the circular plates is {(22/7)*(self.r)**2}")

    def circum(self):
        print(f"The circumferance of the circular plates is {2*(22/7)*self.r}")

radius=float(input("Enter the radius: "))
a2=circle(radius)
a2.carea()
a2.circum()

