#Task - A school admissions team needs to store and print each student's ID, name, department, and marks using separate records that behave like objects.

class Student:
    def __init__(self,i,name,dep,mark):
        self.i=i
        self.name=name
        self.dep=dep
        self.mark=mark

    def show(self):
        print("-"*50)
        print("STUDENT DETAILS".center(50," "))
        print("-"*50)
        print(f"Student ID: {self.i}")
        print(f"Name: {self.name}")
        print(f"Department: {self.dep}")
        print(f"Mark: {self.mark}")
        print("-"*50)

a=Student(1,"Selva","Cyber",9.9)
b=Student(2,"Surya","EEE",9.8)
a.show()
b.show()

