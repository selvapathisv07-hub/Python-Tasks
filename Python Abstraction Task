#Task - A smart-home platform defines a device interface and lets lights, fans, and AC units implement their own behavior.

class SmartDevice(ABC):
    def __init__(self, name: str):
        self.name = name

    @abstractmethod
    def turn_on(self):
        pass

    @abstractmethod
    def turn_off(self):
        pass


class Light(SmartDevice):
    def turn_on(self):
        return f"{self.name}: Light turned on with 100% brightness"

    def turn_off(self):
        return f"{self.name}: Light turned off"


class Fan(SmartDevice):
    def turn_on(self):
        return f"{self.name}: Fan started spinning at medium speed"

    def turn_off(self):
        return f"{self.name}: Fan stopped"


class AirConditioner(SmartDevice):
    def turn_on(self):
        return f"{self.name}: AC turned on set to 22°C"

    def turn_off(self):
        return f"{self.name}: AC powered off"


devices = [Light("Living Room Light"),Fan("Ceiling Fan"),AirConditioner("Bedroom AC")]

for device in devices:
    print(device.turn_on())
    print(device.turn_off())

#Task - A notification service should call send() on email, SMS, and push-notification objects and dispatch through different channels.

class NotificationChannel(ABC):

    @abstractmethod
    def send(self,recipient,message):
        pass


class EmailNotification(NotificationChannel):

    def send(self,recipient,message):
        return f"Sending Email to {recipient}: {message}"


class SMSNotification(NotificationChannel):

    def send(self,recipient,message):
        return f"Sending SMS to {recipient}: {message}"


class PushNotification(NotificationChannel):

    def send(self,recipient,message):
        return f"Sending Push Notification to {recipient}: {message}"


class NotificationService:

    def __init__(self, channels):
        self.channels = channels

    def notify_all(self,recipient,message):
        for channel in self.channels:
            print(channel.send(recipient, message))


channels = [EmailNotification(),SMSNotification(),PushNotification()]

service = NotificationService(channels)
service.notify_all("user@example.com", "Your order has been shipped!")

