from abc import ABC, abstractmethod

#Task - A zoo app defines a generic animal concept and requires every animal type to provide its own sound behavior.

class Animal(ABC):

    @abstractmethod
    def sound(self):
        pass

class Dog(Animal):

    def sound(self):
        print(f"The dog barks : woof! Woof!")

class Cat(Animal):

    def sound(self):
        print(f"The cat sounds : Meow! Meow!")

class Lion(Animal):

    def sound(self):
        print(f"The lion roars : Aaaarrrrhhhh!!!")

lion=Lion()
dog=Dog()
cat=Cat()
lion.sound()
dog.sound()
cat.sound()

#Task - A graphics system defines a generic shape contract and requires each concrete shape to implement area calculation.

class Shape(ABC):

    @abstractmethod
    def area(self):
        pass

class Circle(Shape):

    def area(self,radius):
        print(f"The area of the circle of radius {radius} is {(22/7)*(radius**2)}m²")

class Rectangle(Shape):

    def area(self,l,b):
        print(f"The area of the rectangle of length {l} and width {b} is {l*b}m²")

class Triangle(Shape):

    def area(self,height,base):
        print(f"The area of the triangle of height {height} and base {base} is {(1/2)*base*height}m²")

ci=Circle()
re=Rectangle()
tri=Triangle()
ci.area(8)
re.area(5,6)
tri.area(4,6)

